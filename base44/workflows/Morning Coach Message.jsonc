{
  "name": "Morning Coach Message",
  "description": "Every morning at 8am, Sparky sends each active user their one task for today with encouragement.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "morning_coach_message",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_morning_nudge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "coachDailyNudge",
            "args": {
              "kind": "morning"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send morning message",
            "description": "Today's task + encouragement"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}