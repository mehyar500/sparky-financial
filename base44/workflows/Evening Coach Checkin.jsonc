{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "evening_coach_checkin",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_checkin_nudge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "coachDailyNudge",
            "args": {
              "kind": "checkin"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send evening check-in",
            "description": "Progress + earnings prompt"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 19 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every evening at 7pm, Sparky asks each active user what moved today and what they earned.",
  "name": "Evening Coach Check-in"
}