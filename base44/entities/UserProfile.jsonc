{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "situation": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "hours_per_week": {
      "type": "string"
    },
    "selected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra_skills_text": {
      "type": "string"
    },
    "asset_counts": {
      "type": "object"
    },
    "option1": {
      "type": "object"
    },
    "option2": {
      "type": "object"
    },
    "chosen_option": {
      "type": "object"
    },
    "active_streams": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "progress_percent": {
      "type": "number"
    },
    "tasks_completed": {
      "type": "number"
    },
    "total_tasks": {
      "type": "number"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "money_earned": {
      "type": "number"
    },
    "first_goal_amount": {
      "type": "number"
    },
    "milestone_badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkin_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "weekly_reviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "is_paid": {
      "type": "boolean"
    },
    "onboarding_complete": {
      "type": "boolean"
    },
    "language": {
      "type": "string"
    },
    "language_preference": {
      "type": "string",
      "enum": [
        "auto",
        "en",
        "es",
        "pt"
      ]
    },
    "whatsapp_opt_in": {
      "type": "boolean"
    },
    "whatsapp_prompted": {
      "type": "boolean"
    },
    "daily_nudges_on": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}