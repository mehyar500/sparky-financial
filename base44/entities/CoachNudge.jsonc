{
  "name": "CoachNudge",
  "type": "object",
  "properties": {
    "recipient_user_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "income_path_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "morning",
        "checkin"
      ]
    },
    "nudge_date": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "dismissed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "profile_id",
    "kind",
    "nudge_date",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": {
            "$ne": null
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": {
            "$ne": null
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": {
            "$ne": null
          }
        }
      ]
    }
  }
}