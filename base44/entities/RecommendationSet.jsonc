      "type": "object"
    },
    "option_2_json": {
      "type": "object"
    },
    "rejected_options": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "request_for_alternatives": {
      "type": "string"
    },
    "date_generated": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
