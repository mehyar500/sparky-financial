{
  "name": "CheckIn",
  "type": "object",
  "properties": {
    "income_path_id": {
      "type": "string"
    },
    "check_in_date": {
      "type": "string"
    },
    "progress_response": {
      "type": "string"
    },
    "amount_earned": {
      "type": "number"
    },
    "blocker": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "next_recommended_action": {
      "type": "string"
    }
  },
  "required": [
    "income_path_id",
    "check_in_date",
    "progress_response"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}